{
  "name": "studio-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "npm run build -- --watch",
    "start": "concurrently \"npm run build:watch\" \"npm run run:watch\"",
    "run:watch": "cross-env NODE_PATH=./build node --watch-path=./build --enable-source-maps build/index.js",
    "lint": "npm run type:check && npm run prettier:check && npm run lint:code",
    "lint:fix": "npm run prettier:fix && npm run lint:code -- --fix",
    "type:check": "tsc --noEmit",
    "lint:code": "eslint \"./**/*.{js,ts}\" --quiet",
    "prettier:check": "prettier --check \"**/*.{ts,js}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,js}\"",
    "pretest": "npm run lint",
    "test": "npm run test:only",
    "test:only": "jest",
    "test:cov": "npm run test:only -- --coverage",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js",
    "migrations:new": "npm run typeorm migration:create",
    "migrations:auto": "npm run typeorm -- migration:generate -d ./type-orm.config.ts",
    "migrations:up": "npm run typeorm migration:run -- -d ./type-orm.config.ts",
    "migrations:revert": "npm run typeorm migration:revert -- -d ./type-orm.config.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/awilix": "^6.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^4.3.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/otel": "^0.7.0",
    "@fastify/request-context": "^6.0.1",
    "@fastify/swagger": "^9",
    "@fastify/swagger-ui": "^5",
    "@fastify/type-provider-typebox": "^3.6.0",
    "@ikigaians/auth": "^1.0.3",
    "@ikigaians/cache": "^1.5.0",
    "@ikigaians/common": "^1.6.0",
    "@ikigaians/logger": "^1.2.0",
    "@ikigaians/mod": "^1.1.0",
    "@ikigaians/web": "^3.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.58.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.32.0",
    "@sinclair/typebox": "^0.27.8",
    "awilix": "^12.0.3",
    "close-with-grace": "^1.2.0",
    "dotenv": "^16.3.1",
    "fastify": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "pg": "^8.16.3",
    "typeorm": "^0.3.25",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-unicorn": "^50.0.1",
    "jest": "^29.7.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.1.1",
    "prettier-plugin-organize-imports": "^4.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
